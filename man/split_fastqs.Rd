write_example_fastq <- function(path, lengths) {
  records <- unlist(lapply(seq_along(lengths), function(i) {
    sequence <- paste(rep("A", lengths[[i]]), collapse = "")
    quality <- paste(rep("!", lengths[[i]]), collapse = "")
    c(paste0("@read", i), sequence, "+", quality)
