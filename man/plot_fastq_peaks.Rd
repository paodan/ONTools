write_example_fastq(
  file.path(fastq_dir, "sample2.fastq"),
  c(145:155, 395:405)
)

plots <- plot_fastq_peaks(
  fastqs = c("sample1.fastq", "sample2.fastq"),
  path = fastq_dir,
  min_distance = 100,
  x_breaks = NULL,
  print_plots = FALSE
